{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the item check window",
  "windows": [
    "main",
    "item-check"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus"
  ]
}
